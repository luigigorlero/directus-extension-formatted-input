{
	"name": "directus-extension-formatted-input",
	"description": "A simple Rich Inline Editor to format short texts",
	"icon": "extension",
	"version": "2.2.0",
	"license": "MIT",
	"author": {
		"email": "gorliluigi@gmail.com",
		"name": "Luigi Gorlero"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/luigigorlero/directus-extension-formatted-input"
	},
	"keywords": [
		"directus",
		"directus-extension",
		"directus-custom-bundle",
		"directus-custom-interface",
		"directus-custom-display",
		"tiptap",
		"editor"
	],
	"type": "module",
	"files": [
		"dist"
	],
	"directus:extension": {
		"type": "bundle",
		"path": {
			"app": "dist/app.js",
			"api": "dist/api.js"
		},
		"entries": [
			{
				"type": "interface",
				"name": "formatted-input-interface",
				"source": "src/interface.ts"
			},
			{
				"type": "display",
				"name": "formatted-input-display",
				"source": "src/display.ts"
			}
		],
		"host": "^10.10.0"
	},
	"scripts": {
		"build": "directus-extension build",
		"dev": "directus-extension build -w --no-minify",
		"link": "directus-extension link",
		"add": "directus-extension add"
	},
	"dependencies": {
		"@tiptap/core": "^2.4.0",
		"@tiptap/extension-bold": "^2.4.0",
		"@tiptap/extension-code": "^2.4.0",
		"@tiptap/extension-document": "^2.4.0",
		"@tiptap/extension-highlight": "^2.4.0",
		"@tiptap/extension-italic": "^2.4.0",
		"@tiptap/extension-link": "^2.4.0",
		"@tiptap/extension-paragraph": "^2.4.0",
		"@tiptap/extension-strike": "^2.4.0",
		"@tiptap/extension-subscript": "^2.4.0",
		"@tiptap/extension-superscript": "^2.4.0",
		"@tiptap/extension-text": "^2.4.0",
		"@tiptap/extension-underline": "^2.4.0",
		"@tiptap/pm": "^2.4.0"
	},
	"devDependencies": {
		"@directus/extensions-sdk": "11.0.7",
		"@directus/schema": "^11.0.2",
		"@directus/types": "^11.1.2",
		"@tiptap/vue-3": "^2.4.0",
		"@types/validator": "^13.11.10",
		"typescript": "^5.4.5",
		"validator": "^13.12.0",
		"vue": "^3.4.27",
		"vue-i18n": "^9.13.1"
	}
}